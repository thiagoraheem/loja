<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	<OutputType>WinExe</OutputType>
	<TargetFramework>net10.0-windows</TargetFramework>
	<UseWindowsForms>true</UseWindowsForms>
	<UseWPF>true</UseWPF>
	<ApplicationIcon>shoppingcart_32x32.ico</ApplicationIcon>
	<Nullable>disable</Nullable>
	<ImplicitUsings>disable</ImplicitUsings>
	<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
	<GenerateResourceDesignerFiles>false</GenerateResourceDesignerFiles>
	<NoWarn>$(NoWarn);NU1510;CS0618;SYSLIB0051</NoWarn>
	<RestoreNoWarn>$(RestoreNoWarn);NU1510</RestoreNoWarn>
	<AssemblyTitle>Loja</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="DevExpress.Win.BonusSkins" Version="24.1.7" />
	<PackageReference Include="DevExpress.Win.Design" Version="24.1.*-*" />
	<PackageReference Include="EntityFramework" Version="6.5.2" />
	<PackageReference Include="FreeSpire.PDF" Version="12.4.0" />
	<PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.11" />
	<PackageReference Include="Zeus.Net.CTe" Version="2026.8.18.2047" />
	<PackageReference Include="Zeus.Net.MDFe" Version="2026.8.18.2047" />
	<PackageReference Include="Zeus.Net.NFe.NFCe" Version="2026.8.18.2047" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\Loja.DAL\Loja.DAL.csproj" />
	<ProjectReference Include="..\NFCE\NFe.Danfe.Base\NFe.Danfe.Base.csproj" />
	<ProjectReference Include="..\NFCE\NFe.Danfe.Nativo\NFe.Danfe.Nativo.csproj" />
	<ProjectReference Include="..\NFCE\Nfe.Impressao\NFe.Impressao.csproj" />
  </ItemGroup>

  <ItemGroup>
	<None Include="Schemas\**\*.xsd" CopyToOutputDirectory="Always" />
	<Content Include="Images\**\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
	<Content Include="shoppingcart_32x32.ico" />
  </ItemGroup>
</Project>
